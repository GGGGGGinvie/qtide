{
    "name": "qtide",
    "displayName": "Qt IDE",
    "description": "Qt 项目辅助插件，支持 qmake (.pro) 和 CMake (CMakeLists.txt) 项目解析与文件树浏览",
    "version": "0.0.9",
    "publisher": "Ginvie",
    "icon": "res/icon/qtide.png",
    "engines": {
        "vscode": "^1.116.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "qmake",
                "aliases": [
                    "qmake",
                    "Qt Project"
                ],
                "extensions": [
                    ".pro",
                    ".pri"
                ],
                "configuration": "./language-configurations/qmake.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "qmake",
                "scopeName": "source.qmake",
                "path": "./syntaxes/qmake.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "qtide_view",
                    "title": "Qtide",
                    "icon": "./res/icon/qtide.svg"
                }
            ]
        },
        "views": {
            "qtide_view": [
                {
                    "id": "qtide.view.project",
                    "name": "Qt 项目"
                },
                {
                    "id": "qtide.view.operations",
                    "name": "操作",
                    "visibility": "collapsed"
                }
            ]
        },
        "commands": [
            {
                "command": "qtide.openProject",
                "title": "打开项目",
                "category": "Qtide"
            },
            {
                "command": "qtide.newProject",
                "title": "新建项目",
                "category": "Qtide"
            },
            {
                "command": "qtide.importProject",
                "title": "导入项目",
                "category": "Qtide"
            },
            {
                "command": "qtide.refreshProject",
                "title": "刷新项目",
                "category": "Qtide",
                "icon": "$(refresh)"
            },
            {
                "command": "qtide.collapseAll",
                "title": "全部折叠",
                "category": "Qtide"
            },
            {
                "command": "qtide.expandAll",
                "title": "全部展开",
                "category": "Qtide"
            },
            {
                "command": "qtide.toggleNode",
                "title": "展开/折叠",
                "category": "Qtide"
            },
            {
                "command": "qtide.openTreeFile",
                "title": "打开文件",
                "category": "Qtide"
            },
            {
                "command": "qtide.revealInExplorer",
                "title": "在资源管理器中显示",
                "category": "Qtide"
            },
            {
                "command": "qtide.copyPath",
                "title": "复制路径",
                "category": "Qtide"
            },
            {
                "command": "qtide.openSettings",
                "title": "Qtide 设置",
                "category": "Qtide"
            },
            {
                "title": "移除项目",
                "category": "Qtide",
                "command": "qtide.removeProject"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "qtide.refreshProject",
                    "when": "view == qtide.view.project",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "qtide.openTreeFile",
                    "when": "view == qtide.view.project && viewItem == qtFile",
                    "group": "navigation@1"
                },
                {
                    "command": "qtide.revealInExplorer",
                    "when": "view == qtide.view.project && viewItem == qtFile",
                    "group": "navigation@2"
                },
                {
                    "command": "qtide.copyPath",
                    "when": "view == qtide.view.project && viewItem == qtFile",
                    "group": "2_path@1"
                },
                {
                    "command": "qtide.refreshProject",
                    "when": "view == qtide.view.project && viewItem == project",
                    "group": "navigation@1"
                },
                {
                    "when": "view == qtide.view.project && viewItem == project",
                    "command": "qtide.removeProject",
                    "group": "2_remove@1"
                },
                {
                    "command": "qtide.toggleNode",
                    "when": "view == qtide.view.project && viewItem =~ /^(project|.*Group)$/",
                    "group": "3_expand@1"
                },
                {
                    "command": "qtide.expandAll",
                    "when": "view == qtide.view.project && viewItem =~ /^(project|.*Group)$/",
                    "group": "3_expand@2"
                },
                {
                    "command": "qtide.collapseAll",
                    "when": "view == qtide.view.project && viewItem =~ /^(project|.*Group)$/",
                    "group": "3_expand@3"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "qtide.view.project",
                "contents": "%qtide.welcome%"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "pnpm run compile && pnpm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/vscode": "^1.116.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^9.39.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "volta": {
        "node": "24.15.0"
    }
}
